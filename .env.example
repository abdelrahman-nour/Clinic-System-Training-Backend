# ===== Supabase (Project Settings ← API Keys) =====
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx

# ===== الحماية من السبام =====
# كلمة سر طويلة عشوائية، ولازم تكون نفس اللي في supabase/008_spam_protection.sql
BOOKING_SERVER_SECRET=

# Cloudflare Turnstile (dash.cloudflare.com ← Turnstile ← Add widget)
# وإنت بتجرب على جهازك ممكن تسيبهم فاضيين: هيشتغل بمفاتيح التجربة
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# رابط الموقع بعد الرفع (عشان صور المشاركة و SEO)
NEXT_PUBLIC_SITE_URL=https://example.com
